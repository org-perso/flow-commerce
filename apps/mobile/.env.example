# Copy to .env and fill with your Firebase web app config
# (Firebase console → Project settings → Your apps → Web app).
# EXPO_PUBLIC_ variables are bundled into the app: never put secrets here.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google Sign-In (native, requires a development build — not available in Expo Go).
# Web client ID: Firebase console → Authentication → Sign-in method → Google → Web SDK configuration.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iOS only: reversed iOS client ID, e.g. com.googleusercontent.apps.1234-abcd
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=

# FlowCommerce API base URL, e.g. http://192.168.1.20:8080 (your Mac's LAN IP, not localhost).
# Leave empty to use the on-device mock until the backend endpoints exist.
EXPO_PUBLIC_API_URL=
