# Copy to .env for local development (`yarn dev`).
PORT=8080
# Matches the postgres service in the root docker-compose.yml.
DATABASE_URL=postgres://flowcommerce:flowcommerce@localhost:5432/flowcommerce
# Firebase project ID (Firebase console → Project settings → General).
FIREBASE_PROJECT_ID=
# Comma-separated origins allowed by CORS (the mobile app does not need CORS).
CORS_ORIGINS=

# Optional: Expo access token, only if "enhanced push security" is enabled on the Expo project.
EXPO_ACCESS_TOKEN=
