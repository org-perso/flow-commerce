# Copy to .env for local development (`yarn dev`).
PORT=8080
DATABASE_URL=postgres://flowcommerce:flowcommerce@localhost:5432/flowcommerce
FIREBASE_PROJECT_ID=
CORS_ORIGINS=

# Admin
ADMIN_CORS_ORIGINS=http://localhost:8000
ADMIN_MFA_KEY=

# Optional: Expo access token, only if "enhanced push security" is enabled on the Expo project.
EXPO_ACCESS_TOKEN=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=flowco-dev

# Subscriptions (docs/subscription.md). "false" until the launch offer ends: no limit applies.
SUBSCRIPTIONS_ENFORCED=false
# Numbers receiving the subscription payments, shown to the owners.
PAYMENT_NUMBER_MVOLA=
PAYMENT_NUMBER_ORANGE_MONEY=
PAYMENT_NUMBER_AIRTEL_MONEY=
