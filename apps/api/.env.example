# Copy to .env for local development (`yarn dev`).
PORT=8080
# Matches the postgres service in the root docker-compose.yml.
DATABASE_URL=postgres://flowcommerce:flowcommerce@localhost:5432/flowcommerce
# Firebase project ID (Firebase console → Project settings → General).
FIREBASE_PROJECT_ID=
# Comma-separated origins allowed by CORS (the mobile app does not need CORS).
CORS_ORIGINS=

# Admin space (af-v3-admin). Origins allowed to call /api/v1/admin with the session cookie,
# e.g. http://localhost:8000 locally, https://admin.flow-commerce.com in production.
ADMIN_CORS_ORIGINS=http://localhost:8000
# Encrypts the admins' MFA secrets (32 bytes, base64): `openssl rand -base64 32`.
# Without it, the admin sign-in answers 503. Never change it once admins are enrolled.
ADMIN_MFA_KEY=

# Optional: Expo access token, only if "enhanced push security" is enabled on the Expo project.
EXPO_ACCESS_TOKEN=
