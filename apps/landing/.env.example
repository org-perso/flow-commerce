# Copy to .env.local for local development. On Vercel, set them in Project > Settings > Environment Variables.
# All optional: without them, the production URLs are used.

# This site (Open Graph image, absolute links)
NEXT_PUBLIC_SITE_URL=http://localhost:8001

# The web app: "Se connecter" and "Essayer gratuitement" buttons
NEXT_PUBLIC_APP_URL=http://localhost:8000

# The Android app on the Play Store
NEXT_PUBLIC_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.flowcommerce.app
